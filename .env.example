# Conexao MySQL (caracteres especiais URL-encoded: % -> %25, $ -> %24, ç -> %C3%A7)
DATABASE_URL="mysql://user:pass@localhost:3306/impermeab"

PORT=3000
JWT_SECRET="change-me"
JWT_EXPIRES="12h"
PUBLIC_BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:5173"

# Uploads / e-mail / WhatsApp / Turnstile (opcional em dev)
UPLOADS_DIR=
EMAIL_FROM="noreply@imper.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
TURNSTILE_SECRET=
RESET_TOKEN_EXPIRES_MIN=10

# Rota sede -> destino (agendamentos)
# Poços de Caldas — R. São Paulo 511, 37701-012
SEDE_LAT=-21.7875
SEDE_LNG=-46.5615
OSRM_URL=https://router.project-osrm.org
GEOCODE_URL=https://nominatim.openstreetmap.org
ROTA_FETCH_TIMEOUT_MS=5000
ROTA_CACHE_TTL_MS=3600000
