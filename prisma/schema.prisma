model CatalogoAtividade {
  id                    String   @id @default(cuid())
  nome                  String
  descricao             String?
  especialidadeNecessaria EspecialidadeAtividade
  tempoEstimadoHoras    Decimal? @db.Decimal(5,2)
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
  subSteps              SubStepAtividade[]
  recursos              RecursoAtividade[]
  atividadesOS          AtividadeOS[]

  @@map("catalogo_atividades")
}

model SubStepAtividade {
  id                    String   @id @default(cuid())
  catalogoAtividadeId   String
  ordem                 Int
  descricao             String
  observacao            String?
  catalogoAtividade     CatalogoAtividade @relation(fields: [catalogoAtividadeId], references: [id])
  checklistExecucao     ChecklistExecucao[]

  @@unique([catalogoAtividadeId, ordem])
  @@map("substep_atividades")
}

model RecursoAtividade {
  id                    String   @id @default(cuid())
  catalogoAtividadeId   String
  tipo                  EnumTipoRecursoAtividade
  itemCatalogoId        Int
  quantidade            Decimal  @default(1) @db.Decimal(10,2)
  catalogoAtividade     CatalogoAtividade @relation(fields: [catalogoAtividadeId], references: [id])

  @@map("recurso_atividades")
}

model Equipe {
  id                    String   @id @default(cuid())
  nome                  String
  osId                  Int
  liderId               Int
  status                EnumStatusEquipe @default(PENDENTE)
  criadoEm              DateTime @default(now())
  os                    OrdemServico @relation(fields: [osId], references: [id])
  lider                 User @relation("EquipeLider", fields: [liderId], references: [id])
  membros               MembroEquipe[]
  atividades            AtividadeOS[]
  separacoes            Separacao[]

  @@map("equipes")
}

model MembroEquipe {
  id                    String   @id @default(cuid())
  equipeId              String
  usuarioId             Int
  funcao                String?
  equipe                Equipe @relation(fields: [equipeId], references: [id])
  usuario               User @relation(fields: [usuarioId], references: [id])

  @@unique([equipeId, usuarioId])
  @@map("membros_equipe")
}

model AtividadeOS {
  id                    String   @id @default(cuid())
  osId                  Int
  faseOSId              Int
  catalogoAtividadeId   String
  equipeId              String?
  dataPrevisao          DateTime?
  status                EnumStatusAtividadeOS @default(PENDENTE)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
  os                    OrdemServico @relation(fields: [osId], references: [id])
  faseOS                FaseOS @relation(fields: [faseOSId], references: [id])
  catalogoAtividade     CatalogoAtividade @relation(fields: [catalogoAtividadeId], references: [id])
  equipe                Equipe? @relation(fields: [equipeId], references: [id])
  checklist             ChecklistExecucao[]
  retiradas             RetiradaEquipamento[]

  @@map("atividades_os")
}

model ChecklistExecucao {
  id                    String   @id @default(cuid())
  atividadeOSId         String
  subStepAtividadeId    String
  status                EnumStatusChecklist @default(PENDENTE)
  concluidoEm           DateTime?
  concluidoPorId        Int?
  observacao            String?
  atividadeOS           AtividadeOS @relation(fields: [atividadeOSId], references: [id])
  subStepAtividade      SubStepAtividade @relation(fields: [subStepAtividadeId], references: [id])
  concluidoPor          User? @relation(fields: [concluidoPorId], references: [id])

  @@map("checklist_execucao")
}
