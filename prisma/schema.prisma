  checklist     ChecklistAtividade[]
  separacoes    Separacao[]
  retiradas     RetiradaEquipamento[]
  entregasEpi   EntregaEpi[]

  @@index([atividadeId])
  @@index([atribuidoAId])
  @@index([criadoPorId])
  @@map("execucoes_atividade")
}

model ChecklistAtividade {
  id                    String              @id @default(cuid())
  executucaoAtividadeId String
  subStepAtividadeId    String
  status                EnumStatusChecklist @default(PENDENTE)
  concluidoEm           DateTime?
  concluidoPorId        Int?
  observacao            String?
  executucaoAtividade   ExecucaoAtividade   @relation(fields: [executucaoAtividadeId], references: [id], onDelete: Cascade)
  concluidoPor          User?               @relation(fields: [concluidoPorId], references: [id])
  subStepAtividade      SubStepAtividade    @relation(fields: [subStepAtividadeId], references: [id])

  @@index([executucaoAtividadeId])
  @@index([concluidoPorId], map: "checklist_atividade_concluidoPorId_fkey")
  @@index([subStepAtividadeId], map: "checklist_atividade_subStepAtividadeId_fkey")
  @@map("checklist_atividade")
}

// ---------- Vocabulário controlado ----------
model Verbo {
  id                  Int                   @id @default(autoincrement())
  nome                String                @unique @db.VarChar(60)
  ativo               Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orcamentoAtividades OrcamentoAtividade[]
  obrasAtividades     ObraAtividade[]
  combinacoes         SubServicoAtividade[]

  @@map("verbos")
}

model Objeto {
  id                  Int                   @id @default(autoincrement())
  nome                String                @unique @db.VarChar(60)
  ativo               Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orcamentoAtividades OrcamentoAtividade[]
  obrasAtividades     ObraAtividade[]
  combinacoes         SubServicoAtividade[]

  @@map("objetos")
}

model LocalObra {
  id                  Int                   @id @default(autoincrement())
  nome                String                @unique @db.VarChar(60)
  ativo               Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orcamentoAtividades OrcamentoAtividade[]
  obrasAtividades     ObraAtividade[]
  combinacoes         SubServicoAtividade[]

  @@map("locais_obra")
}

model Caracteristica {
  id                  Int                   @id @default(autoincrement())
  nome                String                @unique @db.VarChar(60)
  ativo               Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  orcamentoAtividades OrcamentoAtividade[]
  obrasAtividades     ObraAtividade[]
  combinacoes         SubServicoAtividade[]

  @@map("caracteristicas")
}

// ---------- Sub-serviço ----------
model SubServico {
  id                  Int                   @id @default(autoincrement())
  etapaId             Int
  nome                String                @db.VarChar(120)
  ativo               Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  etapa               Etapa                 @relation(fields: [etapaId], references: [id])
  combinacoes         SubServicoAtividade[]
  orcamentoAtividades OrcamentoAtividade[]
  obrasAtividades     ObraAtividade[]
  catalogoAtividades  CatalogoAtividade[]

  @@unique([etapaId, nome])
  @@map("sub_servicos")
}

// Combos vocabulário PERMITIDOS por sub-serviço (combo único por sub-serviço)
model SubServicoAtividade {
  id               Int             @id @default(autoincrement())
  subServicoId     Int
  verboId          Int
  objetoId         Int
  localId          Int?
  caracteristicaId Int?
  ativo            Boolean         @default(true)
  createdAt        DateTime        @default(now())
  subServico       SubServico      @relation(fields: [subServicoId], references: [id], onDelete: Cascade)
  verbo            Verbo           @relation(fields: [verboId], references: [id])
  objeto           Objeto          @relation(fields: [objetoId], references: [id])
  local            LocalObra?      @relation(fields: [localId], references: [id])
  caracteristica   Caracteristica? @relation(fields: [caracteristicaId], references: [id])

  @@unique([subServicoId, verboId, objetoId, localId, caracteristicaId])
  @@map("sub_servico_atividades")
}

// ---------- Ficha da obra (1:1) ----------
model OrcamentoObraFicha {
  id               Int               @id @default(autoincrement())
  orcamentoId      Int               @unique
  // Bloco 2 — medições (proposto; confirmar campos na implementação)
  areaPisoM2       Decimal?          @db.Decimal(10, 2)
  areaParedeM2     Decimal?          @db.Decimal(10, 2)
  areaTetoM2       Decimal?          @db.Decimal(10, 2)
  perimetroM       Decimal?          @db.Decimal(10, 2)
  acabamentoPiso   AcabamentoPiso?
  acabamentoParede AcabamentoParede?
  tipoForro        TipoForro?
  tipoEsquadria    TipoEsquadria?
  // Bloco 3 — padrão e cuidados
  padraoAcabamento PadraoAcabamento?
  caixasLuz        Int?
  cuidados         Json              @default("[]")
  // Bloco 4 — análise crítica (gate de aprovação: 3 pares completos)
  risco1           String?           @db.VarChar(500)
  acao1            String?           @db.VarChar(500)
  risco2           String?           @db.VarChar(500)
  acao2            String?           @db.VarChar(500)
  risco3           String?           @db.VarChar(500)
  acao3            String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orcamento        Orcamento         @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@map("orcamento_obra_fichas")
}

// ---------- Linhas de orçamento (substitui OrcamentoItem) ----------
model OrcamentoAtividade {
  id                  String                       @id @default(cuid())
  orcamentoId         Int
  etapaId             Int
  subServicoId        Int
  catalogoAtividadeId String
  descricao           String                       @db.VarChar(1000)
  verboId             Int
  objetoId            Int
  localId             Int?
  caracteristicaId    Int?
  unidadeId           Int?
  quantidade          Decimal?                     @db.Decimal(10, 3)
  areaM2              Decimal?                     @db.Decimal(10, 2)
  moValorHora         Decimal?                     @db.Decimal(10, 2)
  moPessoas           Int?
  moHoras             Decimal?                     @db.Decimal(10, 2)
  moValorTotal        Decimal                      @default(0) @db.Decimal(12, 2)
  materiaisValor      Decimal                      @default(0) @db.Decimal(12, 2)
  linhaValorTotal     Decimal                      @default(0) @db.Decimal(12, 2)
  ordem               Int
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  orcamento           Orcamento                    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  etapa               Etapa                        @relation(fields: [etapaId], references: [id])
  subServico          SubServico                   @relation(fields: [subServicoId], references: [id])
  catalogoAtividade   CatalogoAtividade            @relation(fields: [catalogoAtividadeId], references: [id])
  verbo               Verbo                        @relation(fields: [verboId], references: [id])
  objeto              Objeto                       @relation(fields: [objetoId], references: [id])
  local               LocalObra?                   @relation(fields: [localId], references: [id])
  caracteristica      Caracteristica?              @relation(fields: [caracteristicaId], references: [id])
  materiais           OrcamentoAtividadeMaterial[]

  @@index([orcamentoId])
  @@map("orcamento_atividades")
}

model OrcamentoAtividadeMaterial {
  id                   Int                @id @default(autoincrement())
  orcamentoAtividadeId String
  materialId           Int
  quantidade           Decimal            @db.Decimal(10, 3)
  custoUnitario        Decimal            @db.Decimal(10, 2) // SNAPSHOT no create
  createdAt            DateTime           @default(now())
  orcamentoAtividade   OrcamentoAtividade @relation(fields: [orcamentoAtividadeId], references: [id], onDelete: Cascade)
  material             Material           @relation(fields: [materialId], references: [id])

  @@index([orcamentoAtividadeId])
  @@map("orcamento_atividade_materiais")
}

model Obra {
  id              Int                @id @default(autoincrement())
  codigo          String             @unique @db.VarChar(20) // OBR-NNN (retry como OS-)
  orcamentoId     Int                @unique // 1:1 com o orçamento aprovado
  atendimentoId   Int
  visitaId        Int?
  userId          Int? // cliente
  enderecoId      Int?
  urgencia        Urgencia
  status          StatusObra         @default(EM_PREPARACAO)
  valorContratado Decimal            @default(0.00) @db.Decimal(12, 2)
  areaM2          Decimal?           @db.Decimal(10, 2)
  valorM2         Decimal?           @db.Decimal(10, 2)
  observacoes     String?            @db.VarChar(2000)
  formaPagamento  FormaPagamento?
  aprovadoPorId   Int // cliente (portal) ou admin
  aprovadoEm      DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orcamento       Orcamento          @relation(fields: [orcamentoId], references: [id])
  atendimento     Atendimento        @relation(fields: [atendimentoId], references: [id])
  visita          VisitaTecnica?     @relation(fields: [visitaId], references: [id])
  user            User?              @relation("ObraUser", fields: [userId], references: [id])
  endereco        Endereco?          @relation(fields: [enderecoId], references: [id])
  aprovadoPor     User               @relation("ObraAprovador", fields: [aprovadoPorId], references: [id])
  etapas          ObraEtapa[]
  aditivos        AditivoObra[]
  assinatura      Assinatura?
  acessos         AcessoUser[]
  pagamentos      PagamentoObra[]
  notificacoes    Notificacao[]
  movimentos      MovimentoEstoque[]
  compras         Compra[]

  @@index([atendimentoId])
  @@index([status])
  @@map("obras")
}

model ObraEtapa {
  id         Int             @id @default(autoincrement())
  obraId     Int
  etapaId    Int // referência à Etapa canônica
  nome       String          @db.VarChar(120)
  ordem      Int
  inativo    Boolean         @default(false) // desativação quando já há OS vinculada
  obra       Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  etapa      Etapa           @relation(fields: [etapaId], references: [id])
  atividades ObraAtividade[]

  @@index([obraId])
  @@index([etapaId])
  @@map("obras_etapas")
}

model ObraAtividade {
  id                  String                  @id @default(cuid())
  obraEtapaId         Int
  subServicoId        Int
  catalogoAtividadeId String
  descricao           String                  @db.VarChar(1000)
  verboId             Int
  objetoId            Int
  localId             Int?
  caracteristicaId    Int?
  unidadeId           Int?
  quantidade          Decimal?                @db.Decimal(10, 3)
  areaM2              Decimal?                @db.Decimal(10, 2)
  moValorHora         Decimal?                @db.Decimal(10, 2)
  moPessoas           Int?
  moHoras             Decimal?                @db.Decimal(10, 3)
  moValorTotal        Decimal                 @default(0.00) @db.Decimal(12, 2)
  materiaisValor      Decimal                 @default(0.00) @db.Decimal(12, 2)
  linhaValorTotal     Decimal                 @default(0.00) @db.Decimal(12, 2)
  ordem               Int
  aditivoId           Int? // null = base; set = criado por aditivo
  cancelada           Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  obraEtapa           ObraEtapa               @relation(fields: [obraEtapaId], references: [id], onDelete: Cascade)
  subServico          SubServico              @relation(fields: [subServicoId], references: [id])
  catalogoAtividade   CatalogoAtividade       @relation(fields: [catalogoAtividadeId], references: [id])
  verbo               Verbo                   @relation(fields: [verboId], references: [id])
  objeto              Objeto                  @relation(fields: [objetoId], references: [id])
  local               LocalObra?              @relation(fields: [localId], references: [id])
  caracteristica      Caracteristica?         @relation(fields: [caracteristicaId], references: [id])
  materiais           ObraAtividadeMaterial[]
  execucoes           ExecucaoAtividade[]

  @@index([obraEtapaId])
  @@index([aditivoId])
  @@map("obras_atividades")
}

model ObraAtividadeMaterial {
  id              Int           @id @default(autoincrement())
  obraAtividadeId String
  materialId      Int
  quantidade      Decimal       @db.Decimal(10, 3)
  custoUnitario   Decimal       @db.Decimal(10, 2)
  obraAtividade   ObraAtividade @relation(fields: [obraAtividadeId], references: [id], onDelete: Cascade)
  material        Material      @relation(fields: [materialId], references: [id])

  @@index([obraAtividadeId])
  @@map("obras_atividades_materiais")
}

// ---------- Frota (veículos) ----------
model StatusVeiculo {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(50)
  ativo     Boolean   @default(true)
  ordem     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  veiculos  Veiculo[]

  @@map("status_veiculo")
}

model TipoVeiculo {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(50)
  ativo     Boolean   @default(true)
  ordem     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  veiculos  Veiculo[]

  @@map("tipo_veiculo")
}

model Veiculo {
  id            Int                @id @default(autoincrement())
  codigo        String             @unique @db.VarChar(50)
  placa         String             @unique @db.VarChar(10)
  descricao     String             @db.VarChar(255)
  modelo        String?            @db.VarChar(120)
  ano           Int?
  combustivel   CombustivelVeiculo @default(GASOLINA)
  odometroAtual Decimal            @default(0) @db.Decimal(7, 1)
  observacoes   String?            @db.VarChar(1000)
  ativo         Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  marcaId       Int?
  marca         Marca?        @relation(fields: [marcaId], references: [id])
  corId         Int?
  cor           Cor?          @relation(fields: [corId], references: [id])
  tipoId        Int
  tipo          TipoVeiculo   @relation(fields: [tipoId], references: [id])
  statusId      Int
  status        StatusVeiculo @relation(fields: [statusId], references: [id])
  responsavelId Int?
  responsavel   User?         @relation(fields: [responsavelId], references: [id])

  registrosKm    RegistroKmVeiculo[]
  abastecimentos AbastecimentoVeiculo[]
  manutencoes    ManutencaoVeiculo[]

  @@index([statusId])
  @@index([tipoId])
  @@index([marcaId])
  @@index([responsavelId])
  @@index([descricao])
  @@map("veiculos")
}

model RegistroKmVeiculo {
  id           Int      @id @default(autoincrement())
  data         DateTime @db.Date
  odometro     Decimal  @db.Decimal(7, 1)
  kmPercorrido Decimal  @db.Decimal(9, 2)
  observacao   String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  veiculoId       Int
  veiculo         Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  registradoPorId Int?
  registradoPor   User?   @relation(fields: [registradoPorId], references: [id])

  @@unique([veiculoId, data])
  @@index([veiculoId, data])
  @@map("registros_km_veiculo")
}

model AbastecimentoVeiculo {
  id            Int      @id @default(autoincrement())
  data          DateTime @db.Date
  odometro      Decimal  @db.Decimal(7, 1)
  litros        Decimal  @db.Decimal(12, 3)
  valorTotal    Decimal  @db.Decimal(12, 2)
  precoLitro    Decimal  @db.Decimal(12, 4)
  kmDesdeUltimo Decimal? @db.Decimal(9, 2)
  kmPorLitro    Decimal? @db.Decimal(12, 4)
  observacao    String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  veiculoId       Int
  veiculo         Veiculo     @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  fornecedorId    Int?
  fornecedor      Fornecedor? @relation(fields: [fornecedorId], references: [id])
  registradoPorId Int?
  registradoPor   User?       @relation(fields: [registradoPorId], references: [id])

  @@index([veiculoId])
  @@index([data])
  @@map("abastecimentos_veiculo")
}

model ManutencaoVeiculo {
  id                Int              @id @default(autoincrement())
  data              DateTime         @db.Date
  descricao         String           @db.VarChar(500)
  local             String?          @db.VarChar(200)
  custoPecas        Decimal          @default(0) @db.Decimal(12, 2)
  custoMaoDeObra    Decimal          @default(0) @db.Decimal(12, 2)
  custoTotal        Decimal          @default(0) @db.Decimal(12, 2)
  status            StatusManutencao @default(PENDENTE)
  proximaManutencao DateTime?        @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  veiculoId               Int
  veiculo                 Veiculo        @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  tipoId                  Int
  tipo                    TipoManutencao @relation(fields: [tipoId], references: [id])
  responsavelManutencaoId Int?
  responsavelManutencao   User?          @relation(fields: [responsavelManutencaoId], references: [id])

  @@index([veiculoId])
  @@index([status])
  @@map("manutencoes_veiculo")
}

